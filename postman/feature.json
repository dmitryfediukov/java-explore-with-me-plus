    {
      "name": "Create event",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const date = new Date(Date.now() + 3 * 24 * 60 * 60 * 1000);",
              "const pad = function (value) { return String(value).padStart(2, '0'); };",
              "const formatted = date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate())",
              "    + ' ' + pad(date.getHours()) + ':' + pad(date.getMinutes()) + ':' + pad(date.getSeconds());",
              "pm.collectionVariables.set('eventDate', formatted);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create event returns 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.collectionVariables.set('eventId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Comment feature event\",\n  \"annotation\": \"An annotation longer than twenty characters\",\n  \"description\": \"A description longer than twenty characters\",\n  \"category\": {{categoryId}},\n  \"eventDate\": \"{{eventDate}}\",\n  \"location\": {\"lat\": 55.75, \"lon\": 37.61},\n  \"participantLimit\": 0,\n  \"requestModeration\": false\n}"
        },
        "url": "{{baseUrl}}/users/{{authorId}}/events"
      }
    },
